{
  "version": 1,
  "note": "Curated, NON-EXHAUSTIVE list of historical CVEs for libraries commonly seen in Android apps. Verify the actual library version in build.gradle / dependency tree before treating a hit as a real finding.",
  "libraries": [
    {
      "name": "OkHttp 3.x",
      "detect": "okhttp3.OkHttpClient",
      "cves": [
        {
          "id": "CVE-2018-20200",
          "fixed_in": "3.12.6",
          "severity": "MEDIUM",
          "summary": "Insufficient permissions on internal cache directories on Android (3.x < 3.12.6 / 4.x < 4.0.0)."
        },
        {
          "id": "CVE-2021-0341",
          "fixed_in": "4.9.2",
          "severity": "MEDIUM",
          "summary": "Hostname verification bypass via specific certificate constructions (3.x < 3.14.9 / 4.x < 4.9.2)."
        }
      ]
    },
    {
      "name": "Apache Commons Collections 3.x",
      "detect": "org.apache.commons.collections.functors.InvokerTransformer",
      "cves": [
        {
          "id": "CVE-2015-7501",
          "fixed_in": "3.2.2",
          "severity": "HIGH",
          "summary": "Java deserialization RCE via InvokerTransformer / TransformedMap; library lacks safe-class gating (fixed in 3.2.2)."
        }
      ]
    },
    {
      "name": "Apache Commons Collections 4.x",
      "detect": "org.apache.commons.collections4.functors.InvokerTransformer",
      "cves": [
        {
          "id": "CVE-2015-7501",
          "fixed_in": "4.1",
          "severity": "HIGH",
          "summary": "Same InvokerTransformer deserialization gadget chain; fixed in 4.1."
        }
      ]
    },
    {
      "name": "Bouncy Castle",
      "detect": "org.bouncycastle.jce.provider.BouncyCastleProvider",
      "cves": [
        {
          "id": "CVE-2018-1000613",
          "fixed_in": "1.60",
          "severity": "MEDIUM",
          "summary": "Padding oracle / decryption issue affecting Bouncy Castle versions before 1.60."
        },
        {
          "id": "CVE-2020-15522",
          "fixed_in": "1.66",
          "severity": "MEDIUM",
          "summary": "ECDSA timing side channel (constant-time issue) in versions before 1.66."
        }
      ]
    },
    {
      "name": "Jackson Databind",
      "detect": "com.fasterxml.jackson.databind.ObjectMapper",
      "cves": [
        {
