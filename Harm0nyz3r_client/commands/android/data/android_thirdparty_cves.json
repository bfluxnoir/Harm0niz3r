        },
        {
          "id": "CVE-2019-12384",
          "fixed_in": "2.9.9",
          "severity": "HIGH",
          "summary": "Polymorphic deserialization gadget via Logback (fixed in 2.9.9 / 2.7.9.5)."
        }
      ]
    },
    {
      "name": "jsoup",
      "detect": "org.jsoup.Jsoup",
      "cves": [
        {
          "id": "CVE-2021-37714",
          "fixed_in": "1.14.2",
          "severity": "MEDIUM",
          "summary": "Uncaught exceptions when parsing malicious HTML (DoS) before 1.14.2."
        }
      ]
    },
    {
      "name": "SQLCipher Android",
